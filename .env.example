# ---------------------------------------------------------------------------
# Git Synapse configuration. Copy to `.env` and edit; docker compose reads it.
# ---------------------------------------------------------------------------

# --- GitHub -----------------------------------------------------------------
# A token with `repo` scope. Required for private repositories.
GITHUB_TOKEN=

# Accounts to scan are configured in the UI (Accounts) or with
# `git-synapse account add <login>`. Adding one is a write, not a redeploy, and
# which repositories it takes -- private, archived, an allowlist -- is carried
# on the account and edited in the same place.
#
# Forks are not among those choices. A fork is taken unless the repository it
# was forked from is also in the corpus, which is the only case where the same
# commits would be stored twice.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=git_synapse
POSTGRES_PASSWORD=git_synapse
POSTGRES_DB=git_synapse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port the database is published on. Change if 5432 is already taken.
POSTGRES_PUBLISHED_PORT=55432

# --- Ingest tuning ----------------------------------------------------------
# Repositories cloned and parsed in parallel.
INGEST_CONCURRENCY=8
# Commits touching more files than this are stored but excluded from pair
# counting. Bulk reformats and vendor bumps would otherwise dominate every
# co-occurrence count while carrying no design signal.
MAX_FILES_PER_COMMIT=60
# Pairs seen fewer times than this are not persisted.
MIN_PAIR_SUPPORT=2
# Rename detection threshold (%) for fully-cloned repos.
RENAME_SIMILARITY=50
# Repos larger than this (KB, from the GitHub API) are mirrored blobless:
# far smaller on disk, but no line-churn data and exact renames only.
# Default 2 GiB. On a typical org this affects only a documentation monorepo.
BLOBLESS_THRESHOLD_KB=2097152
# Force every repo blobless. Fastest ingest, no churn data at all.
FORCE_BLOBLESS=false

# --- Cross-repository coupling ----------------------------------------------
# Two repos never share a commit, so the cross-repo graph is read from what
# repositories declare about each other in their dependency manifests.

# --- Analysis ---------------------------------------------------------------
RECENCY_HALF_LIFE_DAYS=365

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
# Fast tier: refresh already-known repositories. A run re-fetches every mirror
# and rewrites the pair tables -- measured at 683-1662s over 163 repositories,
# so anything under ~30 minutes mostly overlaps itself. Hourly by default. Use
# "*/30 * * * *" or "*/15 * * * *" if you want it snappier; a tick that arrives
# while a run is in flight is dropped, never queued.
REFRESH_CRON=0 * * * *
# Slow tier: additionally re-list the org through the GitHub API to pick up new,
# renamed or archived repositories. The only part that spends API quota.
DISCOVER_CRON=0 3 * * *
SCHEDULER_TZ=UTC
# Run a refresh immediately on scheduler startup.
REFRESH_ON_START=false

# --- Server -----------------------------------------------------------------
# Port 80 lets the UI be reached as a bare hostname (http://git-synapse) once
# /etc/hosts maps it — see `make hostname-install`. Set to something else if
# another service already owns 80.
API_HTTP_PORT=80
# Stable fallback, always published.
API_PUBLISHED_PORT=8080
MCP_PUBLISHED_PORT=8081
LOG_LEVEL=INFO

# --- Hosts other than GitHub -------------------------------------------------
# All optional. A public repository on any host clones with no credential, and
# a host with no client here is cloned anyway -- coupling comes from git log.
# GITLAB_TOKEN=
# BITBUCKET_USER=
# BITBUCKET_TOKEN=
#
# Encrypts the per-source access tokens people paste into the Sources page.
# Any passphrase. Without it, storing one is refused rather than downgraded,
# and the variables above stay the only way to reach a private repository.
# GS_SECRET_KEY=

# --- Who may read the dashboard ---------------------------------------------
# Nothing to set, usually. A deployment with no accounts is open, and the first
# administrator is created from the browser -- deliberately not from here, where
# a password would sit in a shell history, a process listing and every copy of
# this file.
#
# Because that screen is by necessity reachable before anyone is signed in, it
# asks for a one-time setup token. The API mints one on a cold database and
# prints it to its own log:
#
#     docker compose logs api | grep -A3 'setup token'
#
# It stops being accepted the moment the account is created. Set the variable
# below only to claim the account from a script rather than a terminal; it is
# ignored once anyone has an account.
# ADMIN_SETUP_TOKEN=
#
# After that: sign-in is required by default, an administrator may switch it
# off per surface under Jobs -> settings, and anyone may mint an API token for
# agents and scripts (Authorization: Bearer gss_...).
#
# The UI test suites sign in as GS_TEST_EMAIL / GS_TEST_PASSWORD, creating the
# account on a deployment that has none -- which needs GS_SETUP_TOKEN. Set them
# to a real account here if yours already has people.
# GS_TEST_EMAIL=ui-tests@git-synapse.local
# GS_TEST_PASSWORD=ui-tests-password-1234
