# ---------------------------------------------------------------------------
# Git Synapse configuration. Copy to `.env` and edit; docker compose reads it.
# ---------------------------------------------------------------------------

# --- GitHub -----------------------------------------------------------------
# A token with `repo` scope. Required for private repositories.
GITHUB_TOKEN=

# Accounts to scan are configured in the UI (Accounts) or with
# `git-synapse account add <login>`, so that adding one is a write rather than
# a redeploy. The settings below seed a single account on first boot only, for
# a deployment upgrading from the environment-driven version; leave GITHUB_ORG
# blank and nothing is seeded.
GITHUB_ORG=
INCLUDE_PRIVATE=true
INCLUDE_FORKS=true
INCLUDE_ARCHIVED=true
# Comma-separated allowlist. When set, overrides every other filter.
ONLY_REPOS=
SKIP_REPOS=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=git_synapse
POSTGRES_PASSWORD=git_synapse
POSTGRES_DB=git_synapse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port the database is published on. Change if 5432 is already taken.
POSTGRES_PUBLISHED_PORT=55432

# --- Ingest tuning ----------------------------------------------------------
# Repositories cloned and parsed in parallel.
INGEST_CONCURRENCY=8
# Commits touching more files than this are stored but excluded from pair
# counting. Bulk reformats and vendor bumps would otherwise dominate every
# co-occurrence count while carrying no design signal.
MAX_FILES_PER_COMMIT=60
# Merge commits restate their parents' changes, so they are excluded by default.
INCLUDE_MERGES=false
# Pairs seen fewer times than this are not persisted.
MIN_PAIR_SUPPORT=2
# Rename detection threshold (%) for fully-cloned repos.
RENAME_SIMILARITY=50
# Repos larger than this (KB, from the GitHub API) are mirrored blobless:
# far smaller on disk, but no line-churn data and exact renames only.
# Default 2 GiB. On a typical org this affects only a documentation monorepo.
BLOBLESS_THRESHOLD_KB=2097152
# Force every repo blobless. Fastest ingest, no churn data at all.
FORCE_BLOBLESS=false

# --- Cross-repository coupling ----------------------------------------------
# Two repos never share a commit, so cross-repo coupling is computed over
# "change sets": commits grouped by ticket key, or by one author's work session.
CROSSREPO_ENABLED=true
# Regex for an issue key in a commit subject. Default matches JIRA-style keys.
TICKET_PATTERN=([A-Z][A-Z0-9]{1,9}-[0-9]{1,6})
# Commits by one author with no larger gap than this form one work session.
SESSION_GAP_HOURS=4
# Change sets touching more repos than this are stored but excluded from pairing
# (an org-wide dependabot sweep is not a design signal).
MAX_REPOS_PER_CHANGESET=8
# Per change set, per repo, cap on files considered for cross-repo file pairing.
MAX_FILES_PER_REPO_PER_CHANGESET=25
MIN_XREPO_SUPPORT=2
# Transitive chain traversal.
CHAIN_MIN_CONFIDENCE=0.15
CHAIN_MAX_DEPTH=3
# Directed lagged analysis. 6h bins are the validated setting: at 24h,
# directional accuracy drops from 0.70 to 0.64.
LAG_BIN_HOURS=6
LAG_MIN_SUPPORT=1

# --- Analysis ---------------------------------------------------------------
SCORE_BATCH_SIZE=200000
RECENCY_HALF_LIFE_DAYS=365
DEFAULT_QUERY_LIMIT=50
MAX_QUERY_LIMIT=1000

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
# Fast tier: refresh already-known repositories. ~60s on a 272-repo org, almost
# all of it git fetches, so every 15 minutes is comfortable. Use "*/5 * * * *"
# for near-real-time, or "0 * * * *" to be gentle.
REFRESH_CRON=*/15 * * * *
# Slow tier: additionally re-list the org through the GitHub API to pick up new,
# renamed or archived repositories. The only part that spends API quota.
DISCOVER_CRON=0 3 * * *
SCHEDULER_TZ=UTC
# Run a refresh immediately on scheduler startup.
REFRESH_ON_START=false

# --- Server -----------------------------------------------------------------
# Port 80 lets the UI be reached as a bare hostname (http://git-synapse) once
# /etc/hosts maps it — see `make hostname-install`. Set to something else if
# another service already owns 80.
API_HTTP_PORT=80
# Stable fallback, always published.
API_PUBLISHED_PORT=8080
MCP_PUBLISHED_PORT=8081
LOG_LEVEL=INFO
