# Copy to .env; docker compose reads it.

# --- GitHub -----------------------------------------------------------------
# Needed for private repositories and a higher API rate limit.
GITHUB_TOKEN=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=git_synapse
POSTGRES_PASSWORD=git_synapse
POSTGRES_DB=git_synapse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port the database is published on.
POSTGRES_PUBLISHED_PORT=55432

# --- Ingest -----------------------------------------------------------------
INGEST_CONCURRENCY=8
# Commits touching more files than this are stored but not paired.
MAX_FILES_PER_COMMIT=60
# Pairs seen fewer times than this are not stored.
MIN_PAIR_SUPPORT=2
# Rename detection threshold (%); blobless mirrors detect exact renames only.
RENAME_SIMILARITY=50
# Repositories larger than this (KB) are mirrored without file contents.
BLOBLESS_THRESHOLD_KB=2097152
FORCE_BLOBLESS=false

# --- Analysis ---------------------------------------------------------------
RECENCY_HALF_LIFE_DAYS=365

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
# Refreshes known repositories.
REFRESH_CRON=0 * * * *
# Re-lists accounts for new repositories; the only part that spends API quota.
DISCOVER_CRON=0 3 * * *
SCHEDULER_TZ=UTC
REFRESH_ON_START=false

# --- Server -----------------------------------------------------------------
API_HTTP_PORT=80
API_PUBLISHED_PORT=8080
MCP_PUBLISHED_PORT=8081
LOG_LEVEL=INFO

# --- Other hosts (optional) -------------------------------------------------
# GITLAB_TOKEN=
# BITBUCKET_USER=
# BITBUCKET_TOKEN=
# Encrypts access tokens pasted on the Sources page; required to store one.
# GS_SECRET_KEY=

# --- Dashboard access -------------------------------------------------------
# Claims the first administrator from a script instead of `cli admin setup-token`.
# ADMIN_SETUP_TOKEN=
# The account the UI test suites sign in as.
# GS_TEST_EMAIL=ui-tests@git-synapse.local
# GS_TEST_PASSWORD=ui-tests-password-1234
